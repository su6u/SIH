<?xml version="1.0"?>
<sdf version="1.10">
  <model name="kinesis_amr">
    <pose>0 0 0.21 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>150.0</mass>
        <inertia><ixx>4.0</ixx><iyy>5.8</iyy><izz>7.2</izz></inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.92 0.72 0.30</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><mesh><uri>model://kinesis_amr/meshes/amr_shell.obj</uri></mesh></geometry>
        <material><ambient>0.015 0.12 0.22 1</ambient><diffuse>0.025 0.31 0.58 1</diffuse><specular>0.65 0.68 0.72 1</specular></material>
      </visual>
      <visual name="safety_bumper_visual">
        <pose>0.461 0 -0.035 0 0 0</pose>
        <geometry><box><size>0.025 0.54 0.095</size></box></geometry>
        <material><ambient>0.8 0.24 0.01 1</ambient><diffuse>1 0.40 0.015 1</diffuse><emissive>0.16 0.035 0 1</emissive></material>
      </visual>
      <visual name="rear_bumper_visual">
        <pose>-0.461 0 -0.035 0 0 0</pose>
        <geometry><box><size>0.025 0.54 0.095</size></box></geometry>
        <material><ambient>0.11 0.12 0.13 1</ambient><diffuse>0.20 0.22 0.24 1</diffuse><specular>0.45 0.45 0.45 1</specular></material>
      </visual>
      <visual name="top_service_deck">
        <pose>0 0 0.165 0 0 0</pose>
        <geometry><box><size>0.68 0.50 0.055</size></box></geometry>
        <material><ambient>0.045 0.05 0.055 1</ambient><diffuse>0.11 0.12 0.13 1</diffuse><specular>0.75 0.75 0.75 1</specular></material>
      </visual>
      <visual name="lift_turntable">
        <pose>0 0 0.205 0 0 0</pose>
        <geometry><cylinder><radius>0.235</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.20 0.22 0.23 1</ambient><diffuse>0.40 0.43 0.45 1</diffuse><specular>0.85 0.85 0.82 1</specular></material>
      </visual>
      <visual name="lift_grip">
        <pose>0 0 0.224 0 0 0</pose>
        <geometry><cylinder><radius>0.175</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.025 0.027 0.03 1</ambient><diffuse>0.055 0.06 0.065 1</diffuse></material>
      </visual>
      <visual name="front_sensor_window">
        <pose>0.473 0 0.045 0 0 0</pose>
        <geometry><box><size>0.015 0.26 0.065</size></box></geometry>
        <material><ambient>0.015 0.07 0.075 1</ambient><diffuse>0.02 0.16 0.18 1</diffuse><specular>0.9 0.9 0.9 1</specular><emissive>0 0.04 0.05 1</emissive></material>
      </visual>
      <visual name="left_status_light">
        <pose>0.11 0.371 0.08 0 0 0</pose>
        <geometry><box><size>0.42 0.012 0.028</size></box></geometry>
        <material><ambient>0.01 0.42 0.20 1</ambient><diffuse>0.02 0.90 0.42 1</diffuse><emissive>0.01 0.45 0.18 1</emissive></material>
      </visual>
      <visual name="right_status_light">
        <pose>0.11 -0.371 0.08 0 0 0</pose>
        <geometry><box><size>0.42 0.012 0.028</size></box></geometry>
        <material><ambient>0.01 0.42 0.20 1</ambient><diffuse>0.02 0.90 0.42 1</diffuse><emissive>0.01 0.45 0.18 1</emissive></material>
      </visual>
      <visual name="rear_left_light">
        <pose>-0.473 0.22 0.045 0 0 0</pose>
        <geometry><box><size>0.015 0.12 0.052</size></box></geometry>
        <material><ambient>0.45 0.01 0.005 1</ambient><diffuse>0.9 0.025 0.01 1</diffuse><emissive>0.40 0.005 0 1</emissive></material>
      </visual>
      <visual name="rear_right_light">
        <pose>-0.473 -0.22 0.045 0 0 0</pose>
        <geometry><box><size>0.015 0.12 0.052</size></box></geometry>
        <material><ambient>0.45 0.01 0.005 1</ambient><diffuse>0.9 0.025 0.01 1</diffuse><emissive>0.40 0.005 0 1</emissive></material>
      </visual>
      <visual name="left_side_panel">
        <pose>-0.18 0.372 0.015 0 0 0</pose>
        <geometry><box><size>0.30 0.014 0.13</size></box></geometry>
        <material><ambient>0.025 0.03 0.035 1</ambient><diffuse>0.07 0.08 0.09 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
      <visual name="right_side_panel">
        <pose>-0.18 -0.372 0.015 0 0 0</pose>
        <geometry><box><size>0.30 0.014 0.13</size></box></geometry>
        <material><ambient>0.025 0.03 0.035 1</ambient><diffuse>0.07 0.08 0.09 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose relative_to="base_link">0 0.275 -0.12 1.57079632679 0 0</pose>
      <inertial><mass>2.5</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry></collision>
      <visual name="tire"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><material><ambient>0.015 0.015 0.016 1</ambient><diffuse>0.035 0.038 0.04 1</diffuse></material></visual>
      <visual name="hub"><geometry><cylinder><radius>0.052</radius><length>0.065</length></cylinder></geometry><material><ambient>0.20 0.22 0.24 1</ambient><diffuse>0.42 0.45 0.48 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
    </link>
    <link name="right_wheel">
      <pose relative_to="base_link">0 -0.275 -0.12 1.57079632679 0 0</pose>
      <inertial><mass>2.5</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry></collision>
      <visual name="tire"><geometry><cylinder><radius>0.10</radius><length>0.06</length></cylinder></geometry><material><ambient>0.015 0.015 0.016 1</ambient><diffuse>0.035 0.038 0.04 1</diffuse></material></visual>
      <visual name="hub"><geometry><cylinder><radius>0.052</radius><length>0.065</length></cylinder></geometry><material><ambient>0.20 0.22 0.24 1</ambient><diffuse>0.42 0.45 0.48 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <link name="front_caster">
      <pose relative_to="base_link">0.32 0 -0.15 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.055</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.055</radius></sphere></geometry></visual>
    </link>
    <joint name="front_caster_joint" type="ball"><parent>base_link</parent><child>front_caster</child></joint>
    <link name="rear_caster">
      <pose relative_to="base_link">-0.32 0 -0.15 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia></inertial>
      <collision name="collision"><geometry><sphere><radius>0.055</radius></sphere></geometry><surface><friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><sphere><radius>0.055</radius></sphere></geometry></visual>
    </link>
    <joint name="rear_caster_joint" type="ball"><parent>base_link</parent><child>rear_caster</child></joint>

    <link name="lidar_link">
      <pose relative_to="base_link">0.28 0 0.27 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="lidar_base"><pose>0 0 -0.025 0 0 0</pose><geometry><cylinder><radius>0.09</radius><length>0.045</length></cylinder></geometry><material><ambient>0.035 0.04 0.045 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
      <visual name="lidar_glass"><pose>0 0 0.018 0 0 0</pose><geometry><cylinder><radius>0.071</radius><length>0.055</length></cylinder></geometry><material><ambient>0.015 0.08 0.10 1</ambient><diffuse>0.02 0.18 0.22 1</diffuse><specular>0.95 0.95 0.95 1</specular><emissive>0 0.025 0.035 1</emissive></material></visual>
      <visual name="lidar_cap"><pose>0 0 0.052 0 0 0</pose><geometry><cylinder><radius>0.077</radius><length>0.014</length></cylinder></geometry><material><ambient>0.04 0.045 0.05 1</ambient><diffuse>0.10 0.11 0.12 1</diffuse><specular>0.7 0.7 0.7 1</specular></material></visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.05 0 0 0</pose>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan>
          <range><min>0.12</min><max>18.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
        <always_on>true</always_on><visualize>false</visualize>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.55</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
