{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "presentation": {
      "root": "presentation",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "simulator",
          "format": "url",
          "env": "SIMULATOR_URL"
        }
      ]
    },
    "simulator": {
      "root": "simulator",
      "runtime": "python",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/sih/presentation/api/(.*)",
      "destination": {
        "service": "simulator",
        "path": "/api/$1"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "simulator",
        "path": "/api/$1"
      }
    },
    {
      "source": "/sih/presentation",
      "destination": {
        "service": "presentation",
        "path": "/"
      }
    },
    {
      "source": "/sih/presentation/(.*)",
      "destination": {
        "service": "presentation",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "presentation"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)models/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
