# --- Redundant / derived presentation assets (verified unreferenced by the app) ---
# Rendered previews of SVGs that live next to them; regenerate with the
# generate-diagrams.mjs / generate-prototypes.mjs scripts in each folder.
/presentation/assets/**/*.png
/presentation/assets/**/preview/

# Zip bundles of SVGs already stored uncompressed alongside them.
/presentation/assets/**/*.zip

# Unzipped copy of the sibling asset folders (byte-for-byte duplicate).
/presentation/assets/presentation/

# Duplicate of formulas/kinesis-bid-formula*.svg.
/presentation/assets/formulas/kinesis-formula-svgs/

# Orphaned browser traces from the retired 10-scenario demo. manifest.json
# only loads peer-network, conflict-resolution and task-rerouting; regenerate
# any trace with presentation/tools/generate_traces.py.
/presentation/public/data/normal.json
/presentation/public/data/peak-rush.json
/presentation/public/data/low-battery.json
/presentation/public/data/robot-failure.json
/presentation/public/data/priority-order.json
/presentation/public/data/blocked-aisle.json

